# GitHub Personal Access Token (for workflow/API integration)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here

# Fine-Grained Personal Access Token
FINE-GRAINE_PERSONAL_ACCESS_TOKEN=your_fine_grained_pat_here

# Figma Access Token
FIGMA_PERSONAL_ACCESS_TOKEN=your_figma_token_here

# Canva API Credentials
CANVA_CLIENT_ID=your_canva_client_id_here
CANVA_CLIENT_SECRET=your_canva_client_secret_here

# Gemini AI Settings
GEMINI_AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_PROJECT_NUMBER=your_project_number_here

# Application Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/menudb"
PORT=5173
PUBLIC_APP_URL="http://localhost:5173"
