{
  "name": "menumini-commercial",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:setup": "node scripts/setup-preview.mjs",
    "dev:published-demo": "python3 ../scripts/run-menu-public-preview.py",
    "build": "vite build",
    "build:isolated": "node scripts/setup-preview.mjs build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "7.0.1",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4"
  }
}
