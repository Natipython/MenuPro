  "systemFeatures": [
    {
      "id": "mealTimeRestrictions",
      "name": "Meal Time Restrictions",
      "description": "Automatically manages section availability based on the time of day, displaying breakfast items during morning hours and transitioning to lunch and dinner menus.",
      "isEnabled": true,
      "config": {
        "enforceSchedule": true,
        "allowPreOrderOffHours": false
      }
    },
    {
      "id": "milkAlternatives",
      "name": "Milk Alternatives & Dairy Customization",
      "description": "Enables seamless dairy and plant-based milk selections (whole, skim, oat, almond, soy, coconut) across all espresso bar and barista drinks.",
      "isEnabled": true,
      "config": {
        "defaultMilk": "whole-milk",
        "supportedAlternatives": [
          "oat-milk",
          "almond-milk",
          "soy-milk",
          "coconut-milk",
          "skim-milk"
        ]
      }
    },
    {
      "id": "allergenTags",
      "name": "Allergen & Dietary Badges",
      "description": "Displays clear allergen icons and dietary tags (Gluten-Free, Dairy-Free, Nut-Free, Vegan, Vegetarian, Halal) across all menu items with search filtering.",
      "isEnabled": true,
      "config": {
        "displayIcons": true,
        "filterEnabled": true
      }
    },
    {
      "id": "inventoryBadges",
      "name": "Real-Time Inventory & Status Badges",
      "description": "Highlights real-time dish availability statuses such as Sold Out, Chef's Pick, Popular, and Seasonal on menu cards.",
      "isEnabled": true,
      "config": {
        "showSoldOut": true,
        "showBadges": true
      }
    },
    {
      "id": "spiceLevels",
      "name": "Spice Level Indicators",
      "description": "Provides standardized visual chili heat indicators from Mild to Extra Hot for savory dishes, marinades, and sauces.",
      "isEnabled": true,
      "config": {
        "maxLevel": 4,
        "allowCustomization": true
      }
    },
    {
      "id": "kidsMenu",
      "name": "Kids' Menu Bundling",
      "description": "Specialized workflow for family ordering, enforcing child meal portion sizes and meal drink/side bundle selections.",
      "isEnabled": true,
      "config": {
        "maxAge": 12,
        "includeDrinkBundle": true
      }
    }
  ],
