  "systemFeatures": [
    {
      "id": "scoopCounter",
      "name": "Scoop Counter & Flavor Allocator",
      "description": "Interactive scoop counter allowing customers to select their preferred number of scoops (single, double, triple, flight) and assign individual flavors per scoop without pricing errors.",
      "isEnabled": true,
      "config": {
        "maxScoopsPerServing": 4,
        "allowSplitScoops": true,
        "showFlavorAvailability": true,
        "targetSectionIds": [
          "gelato-and-ice-cream",
          "seasonal-and-limited-flavors"
        ]
      }
    },
    {
      "id": "toppingBuilder",
      "name": "Interactive Topping Builder",
      "description": "Step-by-step topping customizer allowing customers to mix-and-match dry toppings, warm confectionery drizzles, whipped toppings, and fresh fruits with live price tallying.",
      "isEnabled": true,
      "config": {
        "maxFreeToppings": 0,
        "allowMultipleSauces": true,
        "showToppingCategories": true,
        "targetSectionIds": [
          "gelato-and-ice-cream",
          "sundaes",
          "waffles-and-crepes",
          "toppings-and-sauces"
        ]
      }
    },
    {
      "id": "preOrder",
      "name": "Advance Pre-Order",
      "description": "Enables customers to schedule advance pickup orders for whole frozen cakes, catering tubs, and party packs with configurable lead times and daily cutoff windows.",
      "isEnabled": true,
      "config": {
        "minLeadTimeHours": 24,
        "maxAdvanceDays": 30,
        "dailyCutoffTime": "18:00",
        "applicableSections": [
          "frozen-cakes-and-pies",
          "party-and-catering-packs"
        ]
      }
    },
    {
      "id": "allergenTags",
      "name": "Allergen & Dietary Tagging",
      "description": "Highlights common frozen dessert allergens (dairy, tree nuts, peanuts, eggs, gluten, soy) and dietary indicators (vegan, dairy-free, gluten-free) on cards and modal windows.",
      "isEnabled": true,
      "config": {
        "displayFormat": "badge-and-modal",
        "highlightAllergens": [
          "contains-dairy",
          "contains-nuts",
          "contains-peanuts",
          "contains-gluten",
          "contains-eggs",
          "contains-soy"
        ],
        "dietaryFilters": [
          "dairy-free",
          "vegan",
          "gluten-free",
          "nut-free",
          "egg-free"
        ]
      }
    },
    {
      "id": "inventoryBadges",
      "name": "Real-Time Tub & Flavor Inventory Badges",
      "description": "Live stock indicators displaying when artisanal tubs are freshly churned, running low (low-tub alert), or sold out for the day, keeping the digital menu synchronized with display dipping cabinets.",
      "isEnabled": true,
      "config": {
        "showLowStockWarning": true,
        "lowStockThreshold": 3,
        "showSoldOut": true,
        "showFreshlyChurnedBadge": true
      }
    },
    {
      "id": "customInscription",
      "name": "Custom Cake & Plaque Inscription",
      "description": "Enables customers ordering ice cream cakes and pies to provide personalized chocolate piped messages, custom edible plaques, and greeting notes.",
      "isEnabled": true,
      "config": {
        "maxCharacterCount": 40,
        "includePlaqueType": true,
        "allowGiftCardMessage": true,
        "targetSectionIds": [
          "frozen-cakes-and-pies"
        ]
      }
    }
  ],
