  "systemFeatures": [
    {
      "id": "comboBuilder",
      "name": "Combo & Meal Deal Builder",
      "isEnabled": true,
      "description": "Guides customers through seamless step-by-step combo assembly, linking main entrée selections with side options and drink preferences at discounted bundle rates.",
      "config": {
        "requireDrinkSelection": true,
        "requireSideSelection": true,
        "allowUpsellPrompts": true,
        "defaultDrinkSize": "medium",
        "defaultSideSize": "medium"
      }
    },
    {
      "id": "sizeUpgrade",
      "name": "One-Click Size Upgrades",
      "isEnabled": true,
      "description": "Triggers high-converting size upsell prompts for fries, drinks, and meal combos from regular to medium or large before order confirmation.",
      "config": {
        "enableOneClickUpgrade": true,
        "promptAtCheckout": true,
        "supportedTiers": [
          "regular",
          "medium",
          "large",
          "extra-large"
        ]
      }
    },
    {
      "id": "mealTimeRestrictions",
      "name": "Meal Time Restrictions",
      "isEnabled": true,
      "description": "Enforces operational breakfast cut-off windows (06:00 to 11:00) with automatic menu switching and advance viewing for upcoming dayparts.",
      "config": {
        "enforceTimeRestrictedSections": true,
        "showUpcomingMenus": true,
        "breakfastCutoffTime": "11:00",
        "autoSwitchMenu": true
      }
    },
    {
      "id": "allergenTags",
      "name": "Allergen & Dietary Badging",
      "isEnabled": true,
      "description": "Displays clear allergen alerts and dietary tags (Gluten-Free, Dairy-Free, Nut-Free, Halal, Vegetarian) across all meal courses for guest safety.",
      "config": {
        "highlightSevereAllergens": true,
        "showDietaryFilters": true,
        "supportedTags": [
          "gluten-free",
          "dairy-free",
          "nut-free",
          "halal",
          "vegetarian",
          "vegan",
          "contains-gluten",
          "contains-dairy",
          "contains-soy",
          "contains-egg"
        ]
      }
    },
    {
      "id": "inventoryBadges",
      "name": "Real-Time Inventory Badges",
      "isEnabled": true,
      "description": "Displays real-time item availability statuses such as 'In Stock', 'Sold Out Today', or 'Low Stock' to prevent ordering unavailable items during peak drive-through rushes.",
      "config": {
        "showLowStockAlert": true,
        "lowStockThreshold": 10,
        "autoMarkSoldOut": true,
        "showSoldOut": true
      }
    },
    {
      "id": "spiceLevels",
      "name": "Spice Level Customization",
      "isEnabled": true,
      "description": "Allows guests to customize heat preferences across fried chicken, tender strips, wings, and specialty dipping sauces.",
      "config": {
        "levels": [
          "none",
          "mild",
          "medium",
          "hot",
          "extra-hot"
        ],
        "defaultLevel": "mild",
        "applicableSectionIds": [
          "chicken-and-tenders",
          "burgers-and-sandwiches",
          "limited-time-offers"
        ]
      }
    },
    {
      "id": "kidsMenu",
      "name": "Kids' Menu Configuration",
      "isEnabled": true,
      "description": "Provides dedicated child-friendly meal bundles combining a smaller main, kid-portioned side, beverage carton, and toy selection.",
      "config": {
        "ageTarget": "12 and under",
        "bundledDrinkIncluded": true,
        "bundledSideIncluded": true,
        "toyOptionIncluded": true
      }
    }
  ],
