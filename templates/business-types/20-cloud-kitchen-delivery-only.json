  "systemFeatures": [
    {
      "id": "deliveryTimeEstimate",
      "name": "Live Delivery & Prep Time Estimates",
      "isEnabled": true,
      "description": "Calculates and displays real-time kitchen preparation times combined with dynamic courier transit windows based on order volume, traffic, and distance to set accurate customer expectations.",
      "config": {
        "displayEstimateOnMenu": true,
        "defaultPrepTimeMinutes": 15,
        "defaultTransitTimeMinutes": 20,
        "peakHourBufferMinutes": 10,
        "showLiveCourierTracking": true,
        "criticalForDelivery": true
      }
    },
    {
      "id": "deliveryZone",
      "name": "Delivery Zone & Radius Management",
      "isEnabled": true,
      "description": "Enforces geographic service boundaries with configurable minimum and maximum delivery radiuses to prevent food quality degradation from excessive transit times.",
      "config": {
        "enforceZoneValidation": true,
        "minDeliveryRadiusKm": 0.5,
        "maxDeliveryRadiusKm": 12.0,
        "enableTieredDeliveryFees": true,
        "minimumOrderAmount": 15.0
      }
    },
    {
      "id": "inventoryBadges",
      "name": "Real-Time Inventory Badges",
      "isEnabled": true,
      "description": "Monitors stock levels and automatically displays 'In Stock', 'Low Stock', or 'Sold Out Today' badges to prevent unfulfillable orders during high-velocity delivery rushes.",
      "config": {
        "showLowStockAlert": true,
        "lowStockThreshold": 8,
        "autoMarkSoldOut": true,
        "hideSoldOutItems": false
      }
    },
    {
      "id": "allergenTags",
      "name": "Allergen & Dietary Badging",
      "isEnabled": true,
      "description": "Displays clear allergen alerts and dietary tags across all menu items to ensure customer safety during remote digital ordering without table service interaction.",
      "config": {
        "highlightSevereAllergens": true,
        "showDietaryFilters": true,
        "supportedTags": [
          "gluten-free",
          "dairy-free",
          "nut-free",
          "halal",
          "vegan",
          "vegetarian",
          "contains-gluten",
          "contains-dairy",
          "contains-nuts",
          "contains-soy",
          "contains-egg",
          "contains-shellfish"
        ]
      }
    },
    {
      "id": "spiceLevels",
      "name": "Spice Level Customization",
      "isEnabled": true,
      "description": "Empowers customers to calibrate heat intensity from zero spice to extreme fiery heat on entrées, bowls, noodles, and dipping sauces.",
