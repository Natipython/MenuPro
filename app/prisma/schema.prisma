datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 🏢 Business & Location Layer

model Business {
  id               String            @id @default(uuid()) @db.Uuid
  ownerId          String            @db.Uuid
  owner            User              @relation("BusinessOwner", fields: [ownerId], references: [id])
  businessTypeId   String            @db.Uuid
  businessType     BusinessType      @relation(fields: [businessTypeId], references: [id])
  name             String            @db.VarChar(255)
  slug             String            @unique @db.VarChar(255)
  description      String?           @db.Text
  logoUrl          String?           @db.VarChar(500)
  coverImageUrl    String?           @db.VarChar(500)
  primaryColor     String?           @db.VarChar(7)
  secondaryColor   String?           @db.VarChar(7)
  fontFamily       String?           @db.VarChar(100)
  defaultLanguage  String            @default("en") @db.VarChar(10)
  defaultCurrency  String            @default("USD") @db.VarChar(3)
  subscriptionTier SubscriptionTier  @default(FREE)
  status           BusinessStatus    @default(PENDING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  branches         Branch[]
  roles            Role[]
  staffAssignments StaffAssignment[]
  auditLogs        AuditLog[]
}

enum SubscriptionTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

model BusinessType {
  id             String     @id @default(uuid()) @db.Uuid
  name           String     @db.VarChar(255)
  slug           String     @unique @db.VarChar(255)
  icon           String?    @db.VarChar(10)
  category       String     @db.VarChar(50)
  description    String?    @db.Text
  templateConfig Json       @db.JsonB
  isActive       Boolean    @default(true)
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  businesses     Business[]
}

model Branch {
  id                String            @id @default(uuid()) @db.Uuid
  businessId        String            @db.Uuid
  business          Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String            @db.VarChar(255)
  slug              String            @unique @db.VarChar(255)
  branchType        BranchType        @default(MAIN)
  addressLine1      String            @db.VarChar(255)
  addressLine2      String?           @db.VarChar(255)
  city              String            @db.VarChar(100)
  stateProvince     String            @db.VarChar(100)
  country           String            @db.VarChar(100)
  postalCode        String            @db.VarChar(20)
  latitude          Decimal?          @db.Decimal(10, 8)
  longitude         Decimal?          @db.Decimal(11, 8)
  phone             String?           @db.VarChar(20)
  email             String?           @db.VarChar(255)
  timezone          String            @default("UTC") @db.VarChar(50)
  isActive          Boolean           @default(true)
  acceptsDineIn     Boolean           @default(true)
  acceptsTakeaway   Boolean           @default(true)
  acceptsDelivery   Boolean           @default(false)
  acceptsPreOrder   Boolean           @default(false)
  deliveryRadiusKm  Decimal?          @db.Decimal(5, 2)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  operatingHours    OperatingHours[]
  tables            Table[]
  qrCodes           QrCode[]
  staffAssignments  StaffAssignment[]
  menus             Menu[]
  orders            Order[]
  dailyReports      DailyReport[]
  staffActivityLogs StaffActivityLog[]
  customerFeedbacks CustomerFeedback[]
  announcements     Announcement[]
  auditLogs         AuditLog[]
}

enum BranchType {
  MAIN
  BRANCH
  FRANCHISE
}

model OperatingHours {
  id                String   @id @default(uuid()) @db.Uuid
  branchId          String   @db.Uuid
  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dayOfWeek         Int      @db.SmallInt // 0 = Sunday, 6 = Saturday
  openTime          DateTime @db.Time
  closeTime         DateTime @db.Time
  isClosed          Boolean  @default(false)
  isHolidayOverride Boolean  @default(false)
  overrideDate      DateTime? @db.Date
  createdAt         DateTime @default(now())
}

model Table {
  id           String      @id @default(uuid()) @db.Uuid
  branchId     String      @db.Uuid
  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableNumber  String      @db.VarChar(20)
  capacity     Int         @db.SmallInt
  zone         String?     @db.VarChar(50)
  status       TableStatus @default(AVAILABLE)
  createdAt    DateTime    @default(now())

  qrCodes      QrCode[]
  orders       Order[]
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  INACTIVE
}

// 🔲 QR Code System

model QrCode {
  id            String    @id @default(uuid()) @db.Uuid
  branchId      String    @db.Uuid
  branch        Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableId       String?   @db.Uuid
  table         Table?    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  qrType        QrType    @default(BRANCH)
  encodedData   String    @db.VarChar(500)
  qrImageUrl    String    @db.VarChar(500)
  shortCode     String    @unique @db.VarChar(20)
  scanCount     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  lastScannedAt DateTime?
}

enum QrType {
  BRANCH
  TABLE
  EVENT
  PROMO
}

// 👤 Users, Roles & Staff

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(255)
  phone             String?   @db.VarChar(20)
  passwordHash      String?   @db.VarChar(255)
  fullName          String    @db.VarChar(255)
  avatarUrl         String?   @db.VarChar(500)
  preferredLanguage String    @default("en") @db.VarChar(10)
  authProvider      AuthProvider @default(EMAIL)
  isVerified        Boolean   @default(false)
  isPlatformAdmin   Boolean   @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  ownedBusinesses   Business[]        @relation("BusinessOwner")
  staffAssignments  StaffAssignment[] @relation("UserAssignments")
  assignedByMe      StaffAssignment[] @relation("AssignedBy")
  placedOrders      Order[]           @relation("CustomerOrders")
  assignedOrders    Order[]           @relation("AssignedStaff")
  statusLogChanges  OrderStatusLog[]  @relation("StatusChangedBy")
  auditLogActions   AuditLog[]        @relation("UserAuditLogs")
  feedbackResponses CustomerFeedback[] @relation("RespondedBy")
  feedbacksLeft     CustomerFeedback[] @relation("CustomerReview")
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
  PHONE
}

model Role {
  id              String   @id @default(uuid()) @db.Uuid
  businessId      String   @db.Uuid
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String   @db.VarChar(100)
  slug            String   @db.VarChar(100)
  description     String?  @db.Text
  isSystemRole    Boolean  @default(false)
  hierarchyLevel  Int      @db.SmallInt
  createdAt       DateTime @default(now())

  permissions     RolePermission[]
  assignments     StaffAssignment[]
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(255)
  category    String   @db.VarChar(50)
  description String?  @db.Text

  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model StaffAssignment {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  user        User             @relation("UserAssignments", fields: [userId], references: [id], onDelete: Cascade)
  businessId  String           @db.Uuid
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId    String?          @db.Uuid
  branch      Branch?          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  roleId      String           @db.Uuid
  role        Role             @relation(fields: [roleId], references: [id])
  status      AssignmentStatus @default(ACTIVE)
  hiredAt     DateTime         @db.Date
  assignedAt  DateTime         @default(now())
  assignedById String?         @db.Uuid
  assignedBy  User?            @relation("AssignedBy", fields: [assignedById], references: [id])
  notes       String?          @db.Text

  activityLogs StaffActivityLog[]
}

enum AssignmentStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
}

// 🍽️ Menu System

model Menu {
  id             String         @id @default(uuid()) @db.Uuid
  branchId       String         @db.Uuid
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name           String         @db.VarChar(255)
  description    String?        @db.Text
  isDefault      Boolean        @default(false)
  isActive       Boolean        @default(true)
  availableFrom  DateTime?      @db.Time
  availableUntil DateTime?      @db.Time
  availableDays  Int[]          // [0,1,2,3,4,5,6]
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  sections       MenuSection[]
}

model MenuSection {
  id                String            @id @default(uuid()) @db.Uuid
  menuId            String            @db.Uuid
  menu              Menu              @relation(fields: [menuId], references: [id], onDelete: Cascade)
  templateSectionId String            @db.VarChar(100)
  name              String            @db.VarChar(255)
  description       String?           @db.Text
  icon              String?           @db.VarChar(10)
  imageUrl          String?           @db.VarChar(500)
  sortOrder         Int               @default(0)
  isVisible         Boolean           @default(true)
  availableFrom     DateTime?         @db.Time
  availableUntil    DateTime?         @db.Time
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  subSections       MenuSubSection[]
  items             MenuItem[]
}

model MenuSubSection {
  id          String      @id @default(uuid()) @db.Uuid
  sectionId   String      @db.Uuid
  section     MenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name        String      @db.VarChar(255)
  description String?     @db.Text
  sortOrder   Int         @default(0)
  isVisible   Boolean     @default(true)
  createdAt   DateTime    @default(now())

  items       MenuItem[]
}

model MenuItem {
  id                  String             @id @default(uuid()) @db.Uuid
  subSectionId        String?            @db.Uuid
  subSection          MenuSubSection?    @relation(fields: [subSectionId], references: [id])
  sectionId           String             @db.Uuid
  section             MenuSection        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name                String             @db.VarChar(255)
  slug                String             @unique @db.VarChar(255)
  description         String?            @db.Text
  shortDescription    String?            @db.VarChar(500)
  basePrice           Decimal            @db.Decimal(10, 2)
  compareAtPrice      Decimal?           @db.Decimal(10, 2)
  currency            String             @default("USD") @db.VarChar(3)
  imageUrl            String?            @db.VarChar(500)
  imageLqip           String?            @db.VarChar(500)
  calories            Int?               
  prepTimeMinutes     Int?               @db.SmallInt
  spiceLevel          Int?               @db.SmallInt
  isAvailable         Boolean            @default(true)
  availabilityStatus  AvailabilityStatus @default(IN_STOCK)
  sortOrder           Int                @default(0)
  badges              String[]           
  allergenTags        String[]           
  dietaryTags         String[]           
  storageInstruction  String?            @db.VarChar(100)
  isAgeRestricted     Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  optionGroups        ItemOptionGroup[]
  orderItems          OrderItem[]
}

enum AvailabilityStatus {
  IN_STOCK
  SOLD_OUT
  SOLD_OUT_TODAY
  SEASONAL
  PRE_ORDER_ONLY
  MADE_TO_ORDER
  COMING_SOON
}

model ItemOptionGroup {
  id             String          @id @default(uuid()) @db.Uuid
  itemId         String          @db.Uuid
  item           MenuItem        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name           String          @db.VarChar(255)
  type           OptionGroupType
  isRequired     Boolean         @default(false)
  minSelections  Int             @default(0) @db.SmallInt
  maxSelections  Int?            @db.SmallInt
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())

  options        ItemOption[]
}

enum OptionGroupType {
  SINGLE_SELECT
  MULTI_SELECT
  TEXT_INPUT
  NUMBER_INPUT
  DATE_PICKER
  TOGGLE
}

model ItemOption {
  id            String          @id @default(uuid()) @db.Uuid
  optionGroupId String          @db.Uuid
  optionGroup   ItemOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  label         String          @db.VarChar(255)
  priceModifier Decimal         @default(0) @db.Decimal(10, 2)
  isDefault     Boolean         @default(false)
  isAvailable   Boolean         @default(true)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
}

// 📋 Order Pipeline

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  orderNumber       String      @unique @db.VarChar(20)
  branchId          String      @db.Uuid
  branch            Branch      @relation(fields: [branchId], references: [id])
  customerId        String?     @db.Uuid
  customer          User?       @relation("CustomerOrders", fields: [customerId], references: [id])
  tableId           String?     @db.Uuid
  table             Table?      @relation(fields: [tableId], references: [id])
  assignedStaffId   String?     @db.Uuid
  assignedStaff     User?       @relation("AssignedStaff", fields: [assignedStaffId], references: [id])
  orderType         OrderType
  status            OrderStatus @default(PENDING)
  subtotal          Decimal     @db.Decimal(10, 2)
  taxAmount         Decimal     @db.Decimal(10, 2)
  discountAmount    Decimal     @default(0) @db.Decimal(10, 2)
  deliveryFee       Decimal     @default(0) @db.Decimal(10, 2)
  totalAmount       Decimal     @db.Decimal(10, 2)
  currency          String      @default("USD") @db.VarChar(3)
  customerName      String?     @db.VarChar(255)
  customerPhone     String?     @db.VarChar(20)
  customerNotes     String?     @db.Text
  estimatedReadyAt  DateTime?
  actualReadyAt     DateTime?
  deliveryAddress   String?     @db.Text
  paymentStatus     PaymentStatus @default(UNPAID)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items             OrderItem[]
  statusLogs        OrderStatusLog[]
  payment           Payment?
  customerFeedback  CustomerFeedback?
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  PRE_ORDER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

model OrderItem {
  id                  String             @id @default(uuid()) @db.Uuid
  orderId             String             @db.Uuid
  order               Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId          String?            @db.Uuid
  menuItem            MenuItem?          @relation(fields: [menuItemId], references: [id])
  itemName            String             @db.VarChar(255)
  quantity            Int                @db.SmallInt
  unitPrice           Decimal            @db.Decimal(10, 2)
  totalPrice          Decimal            @db.Decimal(10, 2)
  specialInstructions String?            @db.Text
  createdAt           DateTime           @default(now())

  options             OrderItemOption[]
}

model OrderItemOption {
  id              String      @id @default(uuid()) @db.Uuid
  orderItemId     String      @db.Uuid
  orderItem       OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  optionGroupName String      @db.VarChar(255)
  optionLabel     String      @db.VarChar(255)
  priceModifier   Decimal     @default(0) @db.Decimal(10, 2)
}

model OrderStatusLog {
  id         String      @id @default(uuid()) @db.Uuid
  orderId    String      @db.Uuid
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status     OrderStatus
  changedById String?    @db.Uuid
  changedBy  User?       @relation("StatusChangedBy", fields: [changedById], references: [id])
  notes      String?     @db.Text
  createdAt  DateTime    @default(now())
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  orderId        String        @unique @db.Uuid
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method         PaymentMethod
  provider       String?       @db.VarChar(50)
  providerTxId   String?       @db.VarChar(255)
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("USD") @db.VarChar(3)
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
}

enum PaymentMethod {
  CARD
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  WALLET
}

// 📊 Accountability, Reporting & Audit

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String?   @db.Uuid
  branch     Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId     String?   @db.Uuid
  user       User?     @relation("UserAuditLogs", fields: [userId], references: [id])
  action     String    @db.VarChar(100)
  entityType String    @db.VarChar(50)
  entityId   String?   @db.Uuid
  oldValue   Json?     @db.JsonB
  newValue   Json?     @db.JsonB
  ipAddress  String?   @db.VarChar(45)
  userAgent  String?   @db.Text
  createdAt  DateTime  @default(now())
}

model DailyReport {
  id                String   @id @default(uuid()) @db.Uuid
  branchId          String   @db.Uuid
  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  reportDate        DateTime @db.Date
  totalOrders       Int
  completedOrders   Int
  cancelledOrders   Int
  totalRevenue      Decimal  @db.Decimal(12, 2)
  averageOrderValue Decimal  @db.Decimal(10, 2)
  topItems          Json     @db.JsonB
  peakHour          Int      @db.SmallInt
  uniqueCustomers   Int
  newCustomers      Int
  createdAt         DateTime @default(now())
}

model StaffActivityLog {
  id                  String          @id @default(uuid()) @db.Uuid
  staffAssignmentId   String          @db.Uuid
  staffAssignment     StaffAssignment @relation(fields: [staffAssignmentId], references: [id], onDelete: Cascade)
  branchId            String          @db.Uuid
  branch              Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shiftDate           DateTime        @db.Date
  clockIn             DateTime
  clockOut            DateTime?
  ordersHandled       Int             @default(0)
  tablesServed        Int             @default(0)
  totalSales          Decimal         @default(0) @db.Decimal(10, 2)
  notes               String?         @db.Text
  createdAt           DateTime        @default(now())
}

model CustomerFeedback {
  id             String    @id @default(uuid()) @db.Uuid
  orderId        String    @unique @db.Uuid
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  branchId       String    @db.Uuid
  branch         Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId     String?   @db.Uuid
  customer       User?     @relation("CustomerReview", fields: [customerId], references: [id])
  foodRating     Int       @db.SmallInt
  serviceRating  Int       @db.SmallInt
  overallRating  Int       @db.SmallInt
  comment        String?   @db.Text
  isVisible      Boolean   @default(true)
  respondedById  String?   @db.Uuid
  respondedBy    User?     @relation("RespondedBy", fields: [respondedById], references: [id])
  responseText   String?   @db.Text
  createdAt      DateTime  @default(now())
  respondedAt    DateTime?
}

model Announcement {
  id         String           @id @default(uuid()) @db.Uuid
  branchId   String           @db.Uuid
  branch     Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  title      String           @db.VarChar(255)
  message    String           @db.Text
  type       AnnouncementType @default(INFO)
  isActive   Boolean          @default(true)
  startsAt   DateTime?
  expiresAt  DateTime?
  createdAt  DateTime         @default(now())
}

enum AnnouncementType {
  INFO
  WARNING
  PROMO
  HOLIDAY
}
